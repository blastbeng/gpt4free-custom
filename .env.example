# Copia di riferimento della configurazione. Il file .env reale e' generato
# automaticamente da scripts/bootstrap.sh al primo avvio (ExecStartPre della
# unit docker-compose@gpt4free.service): questo file serve solo a sapere quali
# variabili esistono e a cosa servono.

# Chiave richiesta da ogni client OpenAI-compatibile (Authorization: Bearer ...).
# Generata da bootstrap.sh se assente; non impostarla a mano.
G4F_API_KEY=

# Porta host. Il container ascolta sempre su 8080.
G4F_PORT=1337

# Override immagine (default: hlohaus789/g4f:latest-slim).
G4F_IMAGE=hlohaus789/g4f:latest-slim

# Provider applicato a ogni richiesta che non ne specifica uno.
# AutoFree (g4f_ext/) prova automaticamente Yqcloud -> LLM7 -> HuggingSpace ->
# AgentTools -> Cloudflare -> DeepInfra, con circuit breaker nativo di g4f.
# Per forzare un singolo provider: G4F_PROVIDER=Yqcloud
# ATTENZIONE: G4F_* impostate a stringa vuota NON valgono come "unset".
G4F_PROVIDER=AutoFree

# AutoFree misura i provider in background (g4f_ext/health.py) e li ordina da
# solo; queste variabili servono solo a forzare/limitare il comportamento.
# Catena fissa, in ordine (vuoto = ordinamento automatico):
# G4F_AUTOFREE_PROVIDERS=Yqcloud,Cloudflare
# Nomi mai usati, ne' dalla catena ne' dal probe (ogni tentativo su un provider
# browser-based apre una tab, cioe' un renderer):
G4F_AUTOFREE_EXCLUDE=ChatGPT,DeepInfra,Qwen
# G4F_AUTOFREE_TTL_SECONDS=21600        # validita' della misura
# Tetto sul primo token per provider: 25s, non i 15s del default, perche'
# Cloudflare (l'unico turnstile che risponde qui) impiega 13-18s.
G4F_AUTOFREE_PROVIDER_TIMEOUT=25
# G4F_AUTOFREE_PROBE_MODEL=gpt-4o-mini  # modello "generico" usato nel probe
# Worker paralleli del probe: ognuno puo' tenere aperta una tab.
# G4F_AUTOFREE_PROBE_CONCURRENCY=2
# Oltre questo tempo un probe ancora "in corso" e' considerato appeso e
# sbloccato (altrimenti nessun probe nuovo finche' non si riavvia g4f).
# G4F_AUTOFREE_PROBE_WATCHDOG=900

# Browser esterno via CDP (servizio chromium del compose).
# DEVE essere un IP, non il nome del servizio: il server HTTP DevTools di Chrome
# risponde 500 a un header Host che non sia un IP o "localhost". Il 172.31.0.10
# e' l'indirizzo fisso di chromium sulla rete "browser" (vedi docker-compose.yml).
G4F_BROWSER_HOST=172.31.0.10
G4F_BROWSER_PORT=9222

TZ=Europe/Rome

# Limiti/opzioni accettate da g4f (facoltative, gia' coperte dai default).
G4F_TIMEOUT=300
G4F_STREAM_TIMEOUT=300
G4F_PROXY=

# --- Vision ---------------------------------------------------------------
# Chiave di un provider multimodale. AutoFree instrada SOLO le richieste con
# immagini su questa catena; se manca, una richiesta con immagine risponde con
# un errore esplicito invece di inventare (i provider keyless sono text-only).
# GEMINI_API_KEY=            # Google AI Studio (GeminiPro, consigliata)
# GROQ_API_KEY=              # Groq (llama-4 vision)
# OPENROUTER_API_KEY=        # OpenRouter (modelli :free)
# Catena fissa per le immagini (vuoto = solo provider misurati da health.py):
# G4F_AUTOFREE_VISION_PROVIDERS=GeminiPro
# Modello multimodale usato quando il client chiede un nome che il provider non
# conosce (default: gemini-2.5-flash):
# G4F_AUTOFREE_VISION_MODEL=gemini-2.5-flash
# Budget per le richieste con immagine:
# G4F_AUTOFREE_VISION_PROVIDER_TIMEOUT=45
# G4F_AUTOFREE_VISION_TOTAL_TIMEOUT=120
